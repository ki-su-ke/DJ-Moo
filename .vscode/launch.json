{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Docker Attach",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/app"
        }
      ],
      "preLaunchTask": "docker-compose-up",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Starting development server at (https?://\\S+)",
        "uriFormat": "http://localhost:8000"
      }
    }
  ]
}