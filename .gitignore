# ==========================================
# Environments & Secrets (環境変数・機密情報)
# ==========================================
# 秘密鍵やデータベース接続情報を含むファイル
.env
.env.*
!.env.example
*.env
*.key
*.pem

# ==========================================
# Python & Byte-compiled / optimized files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments (仮想環境)
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ==========================================
# Django specific (Django固有のファイル)
# ==========================================
# ローカル開発用データベース (SQLite)
*.sqlite3
*.sqlite3-journal

# 静的ファイル・メディアファイル (ユーザー収集・アップロード画像等)
# ※必要に応じて一部を管理対象にする場合は調整してください
/staticfiles/
/static_root/
/media/

# Djangoのセッション・キャッシュログなど
*.log
local_settings.py

# ==========================================
# Testing & Code Quality (テスト・静的解析)
# ==========================================
# pytest / coverage
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.nox/
.tox/
nosetests.xml
coverage.xml
*.cover
*.py,cover

# mypy / ruff など
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ==========================================
# Editor & IDE (エディタ・OS固有ファイル)
# ==========================================
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ
.idea/

# macOS / Windows
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# Docker / Tools (開発ツール関係)
# ==========================================
# Dockerビルド時のキャッシュ等
.dockerignore.bak
